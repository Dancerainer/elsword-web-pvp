  "consumers": {
    "c4": "Exact MM29211 / originalTrace set EFFECT1..6 / _HEAD_BONE TRACE1: preserve traceActorId; sample actual target each tick.",
    "c4Lifetime": "Retained combat record expires at TriggerTime + Lifetime. Renderer still uses original TriggerCount1 particle lifetime; this upper bound is not claimed as original deletion time.",
    "drone": "Existing sourceAddDroneMarkVisual records survive no-damage cleanup; every source mark samples its actual target Bip01 and expires with its original mark duration.",
    "death": "C4 does not retire merely because target HP reaches0 when the original TRACE_UNIT_DIE_DELETE flag is false."
  },
  "tests": [
    "tests/combat/add-c4-display-v45.test.mjs",
    "tests/combat/add-drone-mark-lifetime-v45.test.mjs"
  ]
}
