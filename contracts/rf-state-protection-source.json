  "semantics": {
    "clock": "m_pXSkinAnim.GetNowAnimationTime(), never state elapsed time or wall clock",
    "stateArmor": {
      "field": "SUPER_ARMOR",
      "default": false,
      "initial": "bSuperArmor and m_bStateSuperArmor assigned at state entry"
    },
    "stateArmorNotRed": {
      "field": "SUPER_ARMOR_NOT_RED",
      "default": true,
      "meaning": "Armor color behavior is separate from protection eligibility"
    },
    "timeArmor": {
      "fieldPrefix": "SUPER_ARMOR_TIME",
      "firstIndex": 0,
      "loader": "Contiguous BeginTable(prefix,index++); stop at first missing table",
      "missingEndpointDefault": 0,
      "entry": "Load ranges, do not execute CommonFrameMoveFuture window loop",
      "frameWindow": "start <= animationTime <= end, inclusive end",
      "disjoint": "Any loaded window can grant armor; empty gaps do not match"
    },
    "invincible": {
      "field": "INVINCIBLE",
      "numbered": false,
      "missingEndpointDefault": -1,
      "missingTable": "start=-1,end=-1,bInvincible=false",
      "entry": "start <= 0 && end > 0; entry does not test the -1 sentinel",
      "frameWindow": "start != -1 && end != -1 && start <= animationTime < end",
      "forceOverride": "positive m_fForceInvincibleTime grants protection after timer update; timing/decrement belongs to host"
    },
    "damageReactCleanup": {
      "gate": "!IsSuperArmor() && !bInvincible && React != RT_DUMMY_DAMAGE && React != RT_FLIP_DIFF_DIR_DUMMY_DAMAGE",
      "excludedTargetValues": {
        "RT_DUMMY_DAMAGE": 7,
        "RT_FLIP_DIFF_DIR_DUMMY_DAMAGE": 22
      },
      "RT_NO_DAMAGE": {
        "value": 0,
        "excludedByThisGate": false
      },
      "scope": "Deletion eligibility for damage-react effect sets; not a damage suppression or hit acceptance rule"
    },
    "defenderHitStop": {
      "distinctFromDamageReactCleanup": true,
      "gate": "!IsSuperArmor() && React != RT_DUMMY_DAMAGE; additionally React != RT_NO_DAMAGE under DAMAGE_REACT_STOPTIME_CONDITION_FIX",
      "fixedV5ExcludedTargetValues": [
        0,
        7
      ],
      "RT_FLIP_DIFF_DIR_DUMMY_DAMAGE": {
        "value": 22,
        "excludedByThisGate": false
      },
      "normalSetter": "SetStopTime(fStopTimeDef), then SetStop2Time(0)",
      "actorTimerUpdate": "future.fStopTime = requested duration; assignment is not max(previous,duration)",
      "lineMapTimerUpdate": "Separate global line map timer takes max(previous, requested duration)",
      "createEffectSpecialCase": "CREATE_DAMAGE_EFFECT/CREATE_EFFECT_SET return early; RAVEN_SECOND_CLASS_CHANGE branch excludes dummy7 and requires fStopTimeDef > 0",
      "nativeInvoker": "Only this pure protection module is tested here; hit acceptance and timer application stay in parent core integration"
    }
  },
  "implementationHostGuards": {
    "clockValidation": "Nonfinite animation clock/force timer rejected; target raw literals do not supply these errors",
    "rangeValidation": "Host nonfinite or nonnumeric endpoints fall back to original field defaults; not a claim about native malformed Lua coercion",
    "numberPrecision": "JS host clocks and parsed numeric literals; source CPP stores floats, bit-exact consumer precision remains separate"
  },
  "explicitLimits": [
    "Fixed V5 Always.h defines DUNGEON_ITEM, SUPER_ARMOR_TIME and DAMAGE_REACT_STOPTIME_CONDITION_FIX. Target2016 compiler macro set is unconfirmed. DUNGEON_ITEM resets armor before window evaluation when no active item/socket armor and no state base armor.",
    "Without that reset path, source armor can retain previous stateParam true; current pure evaluator represents explicit no-item interval recomputation, not all native macro-dependent lifetime behavior.",
    "IsSuperArmor also returns true for m_vecSuperArmorPtr identity buffs, which are outside this state-only evaluator.",
    "Item/socket armor, identity buffs, native force timer decrement/freeze, canceled state order and target full native dispatch are separate consumers.",
    "SUPER_ARMOR prevents selected reactions but does not imply invincibility or suppress HP loss.",
    "The target original client has not been executed; unit checks verify source-backed adapter boundaries, not target-native battle acceptance."
  ],
